@page "/productos"
@rendermode InteractiveServer

<div class="d-flex">
    <!-- Menú lateral -->
    <div class="bg-dark text-white p-3" style="width: 200px; min-height: 100vh;">
        <h5>Segunda</h5>
        <hr />
        <div class="bg-primary p-2 rounded">Productos</div>
    </div>

    <!-- Contenido principal -->
    <div class="p-4 w-100">
        <h2>Productos</h2>

        @if (mensajeError != "")
        {
            <div class="alert alert-danger">
                @mensajeError
            </div>
        }

        <div class="row mb-3">
            <label class="col-2">Inventario</label>
            <div class="col-4">
                <input type="number" class="form-control" @bind="inventarioActual" @bind:event="oninput" />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-2">Nombre</label>
            <div class="col-4">
                <input type="text" class="form-control" @bind="nombreActual" @bind:event="oninput" />
            </div>
        </div>

        <div class="row mb-3">
            <label class="col-2">Departamento</label>
            <div class="col-10">
                <input type="radio" name="depto" value="Frutas" 
                       checked="@(departamentoActual == "Frutas")" 
                       @onchange="@(() => departamentoActual = "Frutas")" /> Frutas &nbsp;
                       
                <input type="radio" name="depto" value="Verduras" 
                       checked="@(departamentoActual == "Verduras")" 
                       @onchange="@(() => departamentoActual = "Verduras")" /> Verduras &nbsp;
                       
                <input type="radio" name="depto" value="Lácteos" 
                       checked="@(departamentoActual == "Lácteos")" 
                       @onchange="@(() => departamentoActual = "Lácteos")" /> Lácteos
            </div>
        </div>

        <div class="mb-3">
            @if (indiceEdicion == -1)
            {
                <button class="btn btn-primary" @onclick="Guardar">Guardar</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="Actualizar">Actualizar</button>
                <button class="btn btn-danger" @onclick="Cancelar">Cancelar</button>
            }
            
            <button class="btn btn-secondary ms-2" @onclick="ToggleVista">
                @(verExistencias ? "Listado" : "Existencias")
            </button>
        </div>

        <hr />

        @if (!verExistencias)
        {
            <h5>Listado de productos</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Inventario</th>
                        <th>Nombre</th>
                        <th>Departamento</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Recorremos la colección usando su propiedad .Count -->
                    @for (int i = 0; i < listaInventarios.Count; i++)
                    {
                        int indiceLocal = i; 
                        
                        <tr>
                            <td>@listaInventarios[indiceLocal]</td>
                            <td>@listaNombres[indiceLocal]</td>
                            <td>@listaDepartamentos[indiceLocal]</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Eliminar(indiceLocal)">🗑️</button>
                                <button class="btn btn-sm btn-outline-dark" @onclick="() => Editar(indiceLocal)">✏️</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <h5>Existencias por departamento</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Frutas</th>
                        <th>Verduras</th>
                        <th>Lácteos</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        @{
                            int frutas = 0, verduras = 0, lacteos = 0;
                            // Recorremos la colección con foreach (PowerPoint 2)
                            foreach (var dep in listaDepartamentos)
                            {
                                if (dep == "Frutas") { frutas++; }
                                else if (dep == "Verduras") { verduras++; }
                                else if (dep == "Lácteos") { lacteos++; }
                            }
                        }
                        <td>@frutas</td>
                        <td>@verduras</td>
                        <td>@lacteos</td>
                    </tr>
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private int inventarioActual = 0;
    private string nombreActual = "";
    private string departamentoActual = "";
    private string mensajeError = "";
    
    // AQUÍ ESTÁN LAS COLECCIONES (List) SIN USAR CLASES
    private List<int> listaInventarios = new List<int>();
    private List<string> listaNombres = new List<string>();
    private List<string> listaDepartamentos = new List<string>();

    private int indiceEdicion = -1;
    private bool verExistencias = false;

    private void Guardar()
    {
        mensajeError = "";

        if (inventarioActual <= 0) { mensajeError = "El número de inventario debe ser un entero positivo."; return; }
        if (string.IsNullOrEmpty(nombreActual)) { mensajeError = "El nombre no puede ser vacío."; return; }
        if (string.IsNullOrEmpty(departamentoActual)) { mensajeError = "Debe seleccionar un departamento."; return; }

        // Validar que no se repita usando .Count de la colección
        for (int i = 0; i < listaInventarios.Count; i++)
        {
            if (listaInventarios[i] == inventarioActual)
            {
                mensajeError = "El número de inventario se encuentra registrado. Debe ser único.";
                return;
            }
        }

        // USO DE MÉTODOS DE COLECCIONES: Add()
        listaInventarios.Add(inventarioActual);
        listaNombres.Add(nombreActual);
        listaDepartamentos.Add(departamentoActual);

        LimpiarFormulario();
    }

    private void Eliminar(int indice)
    {
        // USO DE MÉTODOS DE COLECCIONES: RemoveAt()
        listaInventarios.RemoveAt(indice);
        listaNombres.RemoveAt(indice);
        listaDepartamentos.RemoveAt(indice);
    }

    private void Editar(int indice)
    {
        inventarioActual = listaInventarios[indice];
        nombreActual = listaNombres[indice];
        departamentoActual = listaDepartamentos[indice];
        indiceEdicion = indice;
        mensajeError = "";
    }

    private void Actualizar()
    {
        mensajeError = "";

        if (inventarioActual <= 0) { mensajeError = "El inventario debe ser positivo."; return; }
        if (string.IsNullOrEmpty(nombreActual)) { mensajeError = "El nombre no puede ser vacío."; return; }
        if (string.IsNullOrEmpty(departamentoActual)) { mensajeError = "Seleccione un departamento."; return; }

        for (int i = 0; i < listaInventarios.Count; i++)
        {
            if (listaInventarios[i] == inventarioActual && i != indiceEdicion)
            {
                mensajeError = "El número de inventario se encuentra registrado. Debe ser único.";
                return;
            }
        }

        listaInventarios[indiceEdicion] = inventarioActual;
        listaNombres[indiceEdicion] = nombreActual;
        listaDepartamentos[indiceEdicion] = departamentoActual;

        indiceEdicion = -1;
        LimpiarFormulario();
    }

    private void Cancelar()
    {
        indiceEdicion = -1;
        LimpiarFormulario();
    }

    private void ToggleVista()
    {
        verExistencias = !verExistencias;
    }

    private void LimpiarFormulario()
    {
        inventarioActual = 0;
        nombreActual = "";
        departamentoActual = "";
    }
}